<?xml version="1.0" encoding="utf-8"?>
<!-- Body parts of the white rhinoceros beetle. Every defName carries the ACS_ prefix: the
     original called one of them simply "Core", which any mechanoid or insect mod is free to
     define as well, and the loser of that collision disappears without a word. -->
<Defs>

  <BodyPartDef>
    <defName>ACS_BeetleFirstRing</defName>
    <label>first segment</label>
    <hitPoints>100</hitPoints>
    <skinCovered>false</skinCovered>
    <bleedRate>0</bleedRate>
    <frostbiteVulnerability>0</frostbiteVulnerability>
    <permanentInjuryChanceFactor>0</permanentInjuryChanceFactor>
    <solid>true</solid>
    <tags>
      <li>ManipulationLimbCore</li>
    </tags>
  </BodyPartDef>

