<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>ACS_Gabriel</defName>
    <label>God's Power</label>
    <description>A seraph of immense power, wearing eight wings of water and a sword of crystal. It does not eat, it does not age, and nothing on this world was built to tame it.</description>
    <statBases>
      <ComfyTemperatureMin>-1000</ComfyTemperatureMin>
      <ComfyTemperatureMax>1000</ComfyTemperatureMax>
      <MeatAmount>0</MeatAmount>
      <ImmunityGainSpeed>10</ImmunityGainSpeed>
      <LeatherAmount>100</LeatherAmount>
      <ArmorRating_Blunt>2</ArmorRating_Blunt>
      <ArmorRating_Sharp>2</ArmorRating_Sharp>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <!-- 1.0 wrote <ToxicSensitivity>0</ToxicSensitivity>; 1.6 states the same thing the other way round. -->
      <ToxicResistance>1</ToxicResistance>
      <PsychicSensitivity>0</PsychicSensitivity>
      <PainShockThreshold>1</PainShockThreshold>
      <Flammability>0</Flammability>
      <MoveSpeed>80</MoveSpeed>
      <!-- The original asked for wildness 100 on a 0-1 stat; 1 is that intent, expressed in range. -->
      <Wildness>1</Wildness>
      <MarketValue>1000000</MarketValue>
      <Mass>100</Mass>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <accuracyTouch>0.8</accuracyTouch>
        <accuracyShort>0.8</accuracyShort>
        <accuracyMedium>0.6</accuracyMedium>
        <accuracyLong>0.6</accuracyLong>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ACS_Projectile_Sweep</defaultProjectile>
        <warmupTime>10</warmupTime>
        <range>80</range>
        <forcedMissRadius>10</forcedMissRadius>
        <burstShotCount>8</burstShotCount>
        <ticksBetweenBurstShots>0</ticksBetweenBurstShots>
        <minRange>5</minRange>
        <!-- The 1.0 sound FlameThrower is gone from 1.6; Shot_IncendiaryLauncher is its closest survivor. -->
        <soundCast>Shot_IncendiaryLauncher</soundCast>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>crystal sword</label>
        <capacities>
          <li>Stab</li>
          <li>Poke</li>
          <li>Cut</li>
        </capacities>
        <power>150</power>
        <cooldownTime>1</cooldownTime>
        <linkedBodyPartsGroup>ACS_AngelSword</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>25</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>water wing blade</label>
        <capacities>
          <li>Stab</li>
          <li>Poke</li>
        </capacities>
        <power>75</power>
        <cooldownTime>0.5</cooldownTime>
        <linkedBodyPartsGroup>ACS_FirstWing</linkedBodyPartsGroup>
      </li>
      <li>
        <label>water wing blade</label>
        <capacities>
          <li>Stab</li>
