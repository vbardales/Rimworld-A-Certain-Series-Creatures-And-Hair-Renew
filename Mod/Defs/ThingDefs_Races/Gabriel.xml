  <PawnKindDef ParentName="AnimalKindBase">
    <defName>ACS_Gabriel</defName>
    <label>God's Power</label>
    <race>ACS_Gabriel</race>
    <!-- Kept out of the manhunter pack draw, as vanilla does with its two most dangerous animals:
         Thrumbo at combatPower 500 and AlphaThrumbo at 800 both set this false, and 800 is the
         highest combatPower any base-game animal has. This one is at 10000. The original set the
         flag on the beetle, at 100, and left it off here. -->
    <canArriveManhunter>false</canArriveManhunter>
    <combatPower>10000</combatPower>
    <ecoSystemWeight>0</ecoSystemWeight>
    <!-- The original set minGenerationAge and maxGenerationAge to 0: see the beetle's kind. Dropped. -->
    <labelMale>God's Power</labelMale>
    <labelFemale>God's Power</labelFemale>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>ACS/Animal/Gabriel</texPath>
          <drawSize>8</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>ACS/Animal/Gabriel</texPath>
          <drawSize>8</drawSize>
        </dessicatedBodyGraphicData>
        <butcherBodyPart>
          <bodyPartGroup>ACS_AngelCore</bodyPartGroup>
          <thing>ACS_AngelCore</thing>
        </butcherBodyPart>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
