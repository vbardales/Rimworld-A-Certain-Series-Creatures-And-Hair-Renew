        </capacities>
        <power>75</power>
        <cooldownTime>0.5</cooldownTime>
        <linkedBodyPartsGroup>ACS_SecondWing</linkedBodyPartsGroup>
      </li>
      <li>
        <label>water wing blade</label>
        <capacities>
          <li>Stab</li>
          <li>Poke</li>
        </capacities>
        <power>75</power>
        <cooldownTime>0.5</cooldownTime>
        <linkedBodyPartsGroup>ACS_ThirdWing</linkedBodyPartsGroup>
      </li>
      <li>
        <label>water wing blade</label>
        <capacities>
          <li>Stab</li>
          <li>Poke</li>
        </capacities>
        <power>75</power>
        <cooldownTime>0.5</cooldownTime>
        <linkedBodyPartsGroup>ACS_FourthWing</linkedBodyPartsGroup>
      </li>
      <li>
        <label>water wing blade</label>
        <capacities>
          <li>Stab</li>
          <li>Poke</li>
        </capacities>
        <power>75</power>
        <cooldownTime>0.5</cooldownTime>
        <linkedBodyPartsGroup>ACS_FifthWing</linkedBodyPartsGroup>
